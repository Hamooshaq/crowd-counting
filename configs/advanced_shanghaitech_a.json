{
  "seed": 42,
  "experiment_name": "advanced_shanghaitech_a",
  "data": {
    "root": "./data/ShanghaiTech",
    "part": "A",
    "train_split": "train",
    "val_split": "test",
    "train_batch_size": 1,
    "eval_batch_size": 1,
    "num_workers": 4,
    "pin_memory": true,
    "resize": null,
    "crop_size": null,
    "horizontal_flip": true,
    "downsample_factor": 8
  },
  "model": {
    "name": "advanced_csrnet",
    "load_imagenet_weights": true,
    "dropout": 0.1,
    "context_rates": [1, 2, 4, 8],
    "attention_reduction": 16
  },
  "loss": {
    "density_weight": 1.0,
    "count_weight": 0.1,
    "reduction": "sum"
  },
  "optimizer": {
    "name": "adamw",
    "lr": 1e-05,
    "momentum": 0.9,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "multistep",
    "milestones": [60, 90],
    "gamma": 0.5
  },
  "training": {
    "epochs": 120,
    "device": "cuda",
    "amp": true,
    "grad_clip_norm": 5.0,
    "output_dir": "outputs",
    "save_every": 10
  },
  "evaluation": {
    "save_predictions": false,
    "sample_count": 8
  }
}

